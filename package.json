{
  "name": "personal-expense-tracker-root",
  "version": "1.0.0",
  "private": true,
  "description": "Personal Expense Tracker Monorepo Root",
  "scripts": {
    "dev:backend": "cd backend && mvn spring-boot:run",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run dev",
    "test:backend": "cd backend && mvn test",
    "test:frontend": "npm --prefix frontend run test",
    "build:frontend": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
