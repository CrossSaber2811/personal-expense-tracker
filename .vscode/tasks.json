{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (Spring Boot)",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Scanning for projects.*",
          "endsPattern": ".*Started PersonalExpenseTrackerApplication.*"
        }
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Frontend (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*",
          "endsPattern": ".*Local:.*"
        }
      },
      "presentation": {
        "group": "servers",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run All (Backend + Frontend)",
      "dependsOn": [
        "Run Backend (Spring Boot)",
        "Run Frontend (Vite)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
